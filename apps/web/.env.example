API_BASE_URL=http://api:8000/api
NEXT_PUBLIC_APP_VERSION=v1.0.0

# Opsional, dev-only. Host tambahan yang boleh meminta dev resource Next.js (`/_next/*`).
# Tanpa ini, membuka `next dev` dari perangkat lain (Tailscale, Cloudflare tunnel)
# membuat semua bundel JS dijawab 403 sehingga halaman gagal hydrate.
# Pisah dengan koma. Wildcard subdomain didukung.
# Contoh: NEXT_DEV_ALLOWED_ORIGINS=100.x.y.z,host.tailnet-name.ts.net,*.trycloudflare.com
NEXT_DEV_ALLOWED_ORIGINS=
