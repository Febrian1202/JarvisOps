        <mxCell id="supp_notes" value="&lt;b&gt;Key Architecture Decisions:&lt;/b&gt;&lt;br&gt;&#10;• &lt;b&gt;Polymorphic Audit:&lt;/b&gt; &lt;code&gt;audit_logs&lt;/code&gt; memakai pola &lt;code&gt;module + module_id&lt;/code&gt; tanpa hard foreign key agar log permanen.&lt;br&gt;&#10;• &lt;b&gt;JSON Payload Notifikasi:&lt;/b&gt; &lt;code&gt;notifications.data&lt;/code&gt; berformat JSON untuk fleksibilitas event-driven payload.&lt;br&gt;&#10;• &lt;b&gt;Article Status:&lt;/b&gt; Draft vs Published dikontrol melalui kolom status dengan view_count increment otomatis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#b1b1b1;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
