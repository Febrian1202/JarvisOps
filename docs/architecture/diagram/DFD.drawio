        <mxCell id="formula_box" value="&lt;b&gt;SLA Calculation &amp; Compliance Formulas:&lt;/b&gt;&lt;br&gt;&#10;• &lt;b&gt;sla_deadline&lt;/b&gt; = &lt;code&gt;created_at + sla_duration_minutes&lt;/code&gt;&lt;br&gt;&#10;• &lt;b&gt;SLA Breached Flag&lt;/b&gt; = &lt;code&gt;current_time &amp;gt; sla_deadline AND status NOT IN (RESOLVED, CLOSED)&lt;/code&gt;&lt;br&gt;&#10;• &lt;b&gt;SLA Compliance (%)&lt;/b&gt; = &lt;code&gt;(Tickets Resolved Within SLA / Total Resolved Tickets) * 100&lt;/code&gt;&lt;br&gt;&#10;• &lt;b&gt;Defensive Evaluation:&lt;/b&gt; Proses 4.4 menghitung SLA secara on-the-fly untuk dashboard tanpa tergantung scheduler semata." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1240" width="1400" height="110" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
